# Which gateway to use: twilio | inforu | sms4free | console
SMS_PROVIDER=twilio

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional, instead of TWILIO_FROM:
# TWILIO_MESSAGING_SERVICE_SID=

# --- Inforu (Israeli gateway) ---
# INFORU_USERNAME=
# INFORU_TOKEN=
# INFORU_SENDER=

# --- SMS4Free (Israeli gateway) ---
# SMS4FREE_KEY=
# SMS4FREE_USER=
# SMS4FREE_PASS=
# SMS4FREE_SENDER=
