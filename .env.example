# Where to send the notification. Comma separated, e.g. "telegram,ntfy".
# Options: console | telegram | pushover | ntfy | webhook
NOTIFIERS=console

# --- Telegram ---
# Open a chat with @BotFather, /newbot, and copy the token.
# The chat id is from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pushover ---
PUSHOVER_TOKEN=
PUSHOVER_USER=

# --- ntfy (no account needed: pick a hard-to-guess topic and subscribe in the app) ---
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# --- Generic webhook (Slack / Discord / anything that accepts JSON) ---
NOTIFY_WEBHOOK_URL=
